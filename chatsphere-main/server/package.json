{
  "name": "chatsphere-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-start.ps1 -Port 5000 -Dialect sqlite",
    "dev:reset": "powershell -ExecutionPolicy Bypass -File ./scripts/reset-dev.ps1 -Port 5000 -Dialect sqlite",
    "start": "node index.js",
    "seed": "node seed/seed.js",
    "seed:reset": "powershell -Command \"$env:SEED_RESET='true'; node seed/seed.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.4",
    "nodemailer": "^6.9.15",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "sqlite3": "^6.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
